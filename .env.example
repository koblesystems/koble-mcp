EBMS_SERIAL_NUMBER=
EBMS_USERNAME=
EBMS_PASSWORD=
# Companies this server may read and write, comma-separated, as the company-list endpoint reports them.
EBMS_COMPANIES=sbx
# Optional, while testing: restrict writes to this one company. It is readable by implication,
# so it need not be repeated above. Leave it unset in real use.
# EBMS_SANDBOX=sbx
# Optional per-company credentials, when a company has its own EBMS user:
# EBMS_COF_USERNAME=
# EBMS_COF_PASSWORD=
# Optional JSON-lines request log (method, path, company, status, duration; never bodies or credentials).
# EBMS_LOG_FILE=./logs/requests.jsonl
