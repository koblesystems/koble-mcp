EBMS_SERIAL_NUMBER=
EBMS_USERNAME=
EBMS_PASSWORD=
# Optional: narrow the server to these company IDs. Leave unset and every company the serial
# number reaches is available — the server discovers them, and ebms_companies lists them by name.
# EBMS_COMPANIES=sbx
# Optional, while testing: restrict writes to this one company. It is readable by implication,
# so it need not be repeated above. Leave it unset in real use.
# EBMS_SANDBOX=sbx
# Optional per-company credentials, when a company has its own EBMS user:
# EBMS_COF_USERNAME=
# EBMS_COF_PASSWORD=
# Optional JSON-lines request log (method, path, company, status, duration; never bodies or credentials).
# EBMS_LOG_FILE=./logs/requests.jsonl
# Optional: where mrp_plan writes planner worksheets. Default: a "Koble MRP" folder in Documents.
# KOBLE_OUTPUT_DIR=
# Optional: the bound actions ebms_command will run. Anything else is refused.
# EBMS_ALLOWED_COMMANDS=MarkAllAsShipped,RecalculateAllPrices,CalculateFreight,ChangeCustomer
