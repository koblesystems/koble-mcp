EBMS_SERIAL_NUMBER=
EBMS_USERNAME=
EBMS_PASSWORD=
# Companies this server may read, comma-separated. Company IDs as the company-list endpoint reports them.
EBMS_COMPANIES=sbx
# Companies this server may write to. Keep this to sandboxes.
EBMS_WRITE_COMPANIES=sbx
# Optional per-company credentials, when a company has its own EBMS user:
# EBMS_COF_USERNAME=
# EBMS_COF_PASSWORD=
# Optional JSON-lines request log (method, path, company, status, duration; never bodies or credentials).
# EBMS_LOG_FILE=./logs/requests.jsonl
